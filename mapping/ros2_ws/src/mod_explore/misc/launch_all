#!/bin/bash

set -euo pipefail

SESSION="scout_all"
BASE_DIR="/home/grl-deploy-0/SonicScout_dev_clean/ros2_ws/src/scout/misc"
WS_DIR="$HOME/SonicScout_dev_clean"
DATA_LOG_DAY="$(date +%y%m%d)"
mkdir -p "$WS_DIR/data_logs/$DATA_LOG_DAY"

# Start fresh
tmux kill-session -t "$SESSION" 2>/dev/null || true

# Window 0: equivalent of masterlaunch.sh (follower + audio)
tmux new-session -d -s "$SESSION" -n master -c "$BASE_DIR"
tmux send-keys -t "$SESSION":0.0 "followermin" C-m
tmux split-window -h -t "$SESSION":0.0
tmux send-keys -t "$SESSION":0.1 "audio" C-m

# Window 1: equivalent of echo_topics.sh
tmux new-window -t "$SESSION":1 -n topics -c "$BASE_DIR"
tmux send-keys -t "$SESSION":1.0 "ros2 topic echo /audio/multichannel" C-m
tmux select-pane -t "$SESSION":1.0 -T "Audio"
tmux split-window -h -t "$SESSION":1.0
tmux send-keys -t "$SESSION":1.1 "ros2 topic echo /leader/mavros/local_position/pose" C-m
tmux select-pane -t "$SESSION":1.1 -T "Leader"
tmux split-window -v -t "$SESSION":1.1
tmux send-keys -t "$SESSION":1.2 "ros2 topic echo /follower/mavros/local_position/pose" C-m
tmux select-pane -t "$SESSION":1.2 -T "Follower"
tmux select-pane -t "$SESSION":1.0

# Window 2: equivalent of launch_exp.sh
tmux new-window -t "$SESSION":2 -n experiment -c "$WS_DIR/ros2_ws/src/scout/scout"
tmux split-window -h -t "$SESSION":2.0 -c "$WS_DIR/data_logs/$DATA_LOG_DAY"
tmux split-window -h -t "$SESSION":2.0 -c "$WS_DIR/ros2_ws"
# tmux split-window -v -t "$SESSION":2.1 -c "$WS_DIR/ros2_ws"
# Pre-fill commands only (no Enter) so you can run manually
tmux send-keys -t "$SESSION":2.0 "python acoustic_model_inference_gpu_filter_pth.py \
  --smooth \
  --confidence_high 0.65 \
  --confidence_low 0.52 \
  --confidence_gamma 1.3 \
  --median_window 3" C-m
tmux send-keys -t "$SESSION":2.1 "ros2 launch scout x500_follower_v2_cpp.launch.py"

# Start from the first window
tmux select-window -t "$SESSION":0
tmux set -g mouse on

echo "Started tmux session: $SESSION"
echo "Windows:"
echo "  0: master      (followermin + audio)"
echo "  1: topics      (audio/leader/follower echoes)"
echo "  2: experiment  (commands pre-filled, press Enter manually)"
echo "Attaching: tmux attach -t $SESSION"

if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
